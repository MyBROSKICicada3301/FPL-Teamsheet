# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Written by ./start.sh
.server.pid
server.log

# FPL API responses, cached by fpl/data.py. Rebuilt on demand.
.cache/

# Secrets and personal settings. Never committed. Copy .env.example to .env
# and fill it in; .env.example is the version that belongs in the repository.
.env
.env.*
!.env.example

# Local Claude Code settings, including the preview launch config. Machine
# specific, so it is not shared.
.claude/
