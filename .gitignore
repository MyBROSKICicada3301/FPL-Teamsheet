# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Written by ./start.sh and .\start.ps1. Start-Process cannot aim both
# streams at one file, so the PowerShell side also leaves server.err.log.
.server.pid
*.log

# FPL API responses, cached by fpl/data.py. Rebuilt on demand.
.cache/

# Secrets and personal settings. Never committed. Copy .env.example to .env
# and fill it in; .env.example is the version that belongs in the repository.
.env
.env.*
!.env.example
.claude/
