# Copy this file to .env and fill it in. .env is gitignored; this template is
# not, so never put a real value in here.
#
# Anything already exported in your shell wins over this file, so a one-off
# override still works:  GEMINI_MODEL=gemini-3.6-flash ./start.sh

# Google AI Studio key, for the written briefing. Without it everything else
# works and the briefing panel hides itself.
GEMINI_API_KEY=

# Which Gemini model writes the briefing. Left blank it uses
# gemini-flash-latest, an alias that follows the current flash release and so
# never goes stale. Set an exact id here only if you want it to stop moving.
GEMINI_MODEL=

# Your FPL team id: the number in the URL when you view your own team,
# /entry/1234567/event/4. Used as the default for the CLI and to prefill the
# web form. It is a public id, not a credential.
FPL_TEAM_ID=

# Where cached FPL API responses go. Defaults to .cache/fpl in the project.
# FPL_CACHE=

# Port for ./start.sh and the server.
# PORT=8765
